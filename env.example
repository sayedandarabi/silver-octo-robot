# Fin MaX transfer environment template.
# Copy to .env locally. Never commit real values or paste them into client code.
# Public values may be exposed to the Expo client; server secrets must remain server-only.

NODE_ENV=development
PORT=3000

# Database used by Drizzle/MySQL. Required for db:push and server persistence.
DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/finmax

# Manus/OAuth server values. Use the destination environment's values.
MANUS_PROJECT_ID=
MANUS_OAUTH_PORTAL_URL=https://manus.im
MANUS_OAUTH_API_URL=https://api.manus.ai
MANUS_JWT_SECRET=
OWNER_OPEN_ID=
OWNER_NAME=

# Values exposed to Expo through app.config.ts when running outside Manus.
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000
EXPO_PUBLIC_APP_ID=
EXPO_PUBLIC_OAUTH_PORTAL_URL=https://manus.im
EXPO_PUBLIC_OAUTH_SERVER_URL=https://api.manus.ai
EXPO_PUBLIC_OWNER_OPEN_ID=
EXPO_PUBLIC_OWNER_NAME=

# Optional aliases supported for older environments.
VITE_APP_ID=
VITE_OAUTH_PORTAL_URL=
OAUTH_SERVER_URL=

# Optional server integrations; keep all values server-side.
TELEGRAM_BOT_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_VERSION=v20.0
FINMAX_SCHEDULE_TOKEN=
FINMAX_BACKUP_PASSWORD=

# Optional Manus built-in service configuration.
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
EXPO_WEB_PREVIEW_URL=
EXPO_PACKAGER_PROXY_URL=
